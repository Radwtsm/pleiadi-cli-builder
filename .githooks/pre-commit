#!/bin/sh
# test della logica e niente segreti prima di ogni commit
set -e
cd "$(git rev-parse --show-toplevel)"
for t in tests/test_*.py examples/*/tests/test_*.py; do python3 "$t" >/dev/null 2>&1 || { python3 "$t"; exit 1; }; done
if command -v gitleaks >/dev/null; then gitleaks git --staged --no-banner --redact
else python3 -m pleiadi_cli_builder segreti --staged; fi
